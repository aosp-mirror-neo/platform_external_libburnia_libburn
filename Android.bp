package {
    default_applicable_licenses: ["external_libburnia_libburn_license"],
}

license {
    name: "external_libburnia_libburn_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-GPL-2.0",
    ],
    license_text: [
        "COPYING",
        "COPYRIGHT",
    ],
}

cc_library_host_static {
    name: "libburn",
    defaults: ["libburnia_defaults"],
    srcs: [
        "libburn/async.c",
        "libburn/cdtext.c",
        "libburn/cleanup.c",
        "libburn/crc.c",
        "libburn/debug.c",
        "libburn/drive.c",
        "libburn/ecma130ab.c",
        "libburn/file.c",
        "libburn/init.c",
        "libburn/libdax_audioxtr.c",
        "libburn/libdax_msgs.c",
        "libburn/mmc.c",
        "libburn/null.c",
        "libburn/options.c",
        "libburn/read.c",
        "libburn/sbc.c",
        "libburn/sector.c",
        "libburn/sg.c",
        "libburn/source.c",
        "libburn/spc.c",
        "libburn/structure.c",
        "libburn/toc.c",
        "libburn/util.c",
        "libburn/write.c",
    ],
    export_include_dirs: ["."],
    visibility: ["//external/libburnia:__subpackages__"],
}
